{
  "name": "dilithium-seal",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based ML-DSA (CRYSTALS-Dilithium) cryptographic demo — NIST FIPS 204",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:ci": "npm audit --audit-level=moderate",
    "test:a11y": "playwright test",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "gh-pages": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
