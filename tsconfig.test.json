{
  // The vitest suite, which reads the repo's own config files off disk and will
  // read pinned NIST vectors the same way. It needs Node's types; the shipped
  // browser bundle must not, which is why this is a second pass rather than a
  // `types: ["node"]` added to tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The supply-chain scripts are plain .mjs so `node scripts/x.mjs` runs them
    // with no build step and no loader flag. `allowJs` lets this pass infer
    // their types so the tests that import them are still type-checked.
    "allowJs": true
  },
  "include": ["src/__tests__", "build", "scripts"],
  "exclude": []
}
